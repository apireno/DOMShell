{
  "manifest_version": 3,
  "name": "DOMShell — Browser Filesystem for AI Agents",
  "description": "Browse the web with Linux commands. AI agents use ls, cd, grep, click via MCP. Terminal in Chrome Side Panel.",
  "version": "1.3.1",
  "permissions": [
    "sidePanel",
    "debugger",
    "cookies",
    "storage",
    "alarms",
    "tabGroups"
  ],
  "minimum_chrome_version": "116",
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "DOMShell",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "homepage_url": "https://github.com/apireno/DOMShell",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
