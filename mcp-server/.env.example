# DOMShell MCP server — environment file template (Path 2: docker compose).
#
# Install (one-time):
#   cp .env.example .env
#   # Then edit DOMSHELL_TOKEN to a real value generated with:
#   #   openssl rand -hex 24
#   # The Chrome extension uses the same token: `connect <token>` in the
#   # side panel.
#
# This file is gitignored. The real .env stays on your machine and is
# what `docker compose up -d` reads on every container start (including
# auto-restart after a host reboot — see container-and-toolhive.md).

# REQUIRED — auth token shared between the MCP server and the Chrome
# extension. Generate once with `openssl rand -hex 24` and keep it in
# this .env file; it persists across container restarts and host reboots.
DOMSHELL_TOKEN=replace-me-with-openssl-rand-hex-24-output

# OPTIONAL — tier flags / domain allowlist. Leave commented to keep the
# server's defaults (write tier on via the command in docker-compose.yml,
# sensitive off, all domains allowed).
#
# DOMSHELL_ALLOWED_DOMAINS=example.com,docs.example.com
